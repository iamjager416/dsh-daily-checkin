{
  "name": "dsh-checkin",
  "version": "0.1.1",
  "private": true,
  "description": "每天自动签到：库街区（鸣潮/战双）、森空岛（明日方舟/终末地）、塔吉多（异环）；在设置里用手机号验证码绑定，签完可推送到 QQ。",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.13"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "src",
    "client",
    "cordis.patch.yml",
    "README.md",
    "docs"
  ]
}
